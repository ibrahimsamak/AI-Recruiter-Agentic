# Copy to .env and fill in your keys:  cp .env.example .env
# === Secrets (required) ===
OPENAI_API_KEY=
LANGSMITH_API_KEY=

# === Postgres (required) — pgvector matching store + LangGraph checkpointer ===
# Local dev: docker compose up -d postgres  (see docker-compose.yml)
# AWS: RDS endpoint, e.g. postgresql://user:pass@<rds-endpoint>:5432/dbname
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_recruiter

# === Optional overrides (defaults live in app/config.py) ===
MODEL=openai:gpt-4o-mini
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=ai-recruiter
# OpenAI embedding model name, or "bedrock:<model-id>" (e.g.
# bedrock:amazon.titan-embed-text-v2:0) to drop the OPENAI_API_KEY dependency —
# needs `langchain-aws` installed (see requirements.txt) and AWS_REGION below.
EMBEDDING_MODEL=text-embedding-3-small

# === Generated documents (S3 in prod; local ./outputs when unset) ===
AWS_REGION=ca-central-1
S3_BUCKET=
S3_URL_TTL=3600

# === Gate /ui (interim basic auth; move to ALB OIDC/Cognito later). Leave
# both blank locally to skip the login prompt. ===
GRADIO_AUTH_USER=
GRADIO_AUTH_PASS=

# === MCP servers (defaults assume run_local.sh / docker-compose; override
# with ECS service DNS names in prod, e.g. http://job-boards:8001/mcp) ===
JOB_BOARDS_MCP_URL=http://localhost:8001/mcp
ATS_MCP_URL=http://localhost:8002/mcp
