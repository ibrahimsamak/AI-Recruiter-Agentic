# Copy to .env and fill in your keys:  cp .env.example .env
# === Secrets (required) ===
OPENAI_API_KEY=
LANGSMITH_API_KEY=

# === Optional overrides (defaults live in app/config.py) ===
MODEL=openai:gpt-4o-mini
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=ai-recruiter
# CHROMA_DIR left unset -> defaults to app/rag/chroma (see app/config.py)
EMBEDDING_MODEL=text-embedding-3-small
